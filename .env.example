# MongoDB
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=cambia_esta_clave
MONGO_DB=auth_db

# JWT (obligatorio en producción)
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio_min_32_chars

# URL pública del frontend (CORS y enlaces de los correos).
# Si accedes desde otro dispositivo en tu red, cambia a http://192.168.x.x:5173
FRONTEND_URL=http://localhost:5173

# SMTP (opcional)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Sistema de Autenticación <no-reply@example.com>
