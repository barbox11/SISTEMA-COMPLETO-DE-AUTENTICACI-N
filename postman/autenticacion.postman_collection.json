{
  "info": {
    "name": "Autenticación - Sistema Completo",
    "description": "Colección para probar registro, login, cambio obligatorio, recuperación, reset, perfil y logout. Importa y configura la variable baseUrl.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "token", "value": "" },
    { "key": "correo", "value": "juan@example.com" },
    { "key": "passwordTemporal", "value": "" },
    { "key": "resetToken", "value": "" }
  ],
  "item": [
    {
      "name": "AUTH",
      "item": [
        {
          "name": "Registrar usuario",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan\",\n  \"apellido\": \"Pérez\",\n  \"correo\": \"{{correo}}\",\n  \"rol\": \"usuario\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.passwordTemporal) { pm.collectionVariables.set('passwordTemporal', json.passwordTemporal); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Iniciar sesión",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{correo}}\",\n  \"password\": \"{{passwordTemporal}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) { pm.collectionVariables.set('token', json.token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Cambiar contraseña",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/auth/change-password",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"passwordActual\": \"{{passwordTemporal}}\",\n  \"nuevaPassword\": \"NuevaPassword123!\",\n  \"confirmarPassword\": \"NuevaPassword123!\"\n}"
            }
          }
        },
        {
          "name": "Solicitar recuperación",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/forgot-password",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"correo\": \"{{correo}}\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.tokenDesarrollo) { pm.collectionVariables.set('resetToken', json.tokenDesarrollo); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Restablecer contraseña",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/reset-password",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"nuevaPassword\": \"OtraPassword123!\",\n  \"confirmarPassword\": \"OtraPassword123!\"\n}"
            }
          }
        },
        {
          "name": "Cerrar sesión",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/logout",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Obtener perfil",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/perfil",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "USUARIOS",
      "item": [
        {
          "name": "Actualizar perfil",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/users/me",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Juan\",\n  \"apellido\": \"Pérez Gómez\"\n}" }
          }
        }
      ]
    }
  ]
}
