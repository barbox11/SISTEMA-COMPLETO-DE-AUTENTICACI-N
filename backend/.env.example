# Servidor
PORT=3000
NODE_ENV=development

# Base de datos (Opción Docker local)
MONGODB_URI=mongodb://admin:admin123@127.0.0.1:27017/auth_db?authSource=admin
# Opción Atlas (comenta la anterior y usa esta):
# MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@cluster0.xxxx.mongodb.net/auth_db?retryWrites=true&w=majority

# JWT
JWT_SECRET=CAMBIA_ESTE_SECRETO_LARGO_Y_ALEATORIO_MINIMO_32_CARACTERES
JWT_EXPIRES_IN=1h

# Frontend (para CORS y enlaces de correos)
FRONTEND_URL=http://localhost:5173

# Correo SMTP (compatible con Gmail, Mailtrap, Sendgrid, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_correo@example.com
SMTP_PASSWORD=tu_password_de_aplicacion
SMTP_FROM=Sistema de Autenticación <no-reply@example.com>

# Recuperación de contraseña
PASSWORD_RESET_EXPIRES_MINUTES=15

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
